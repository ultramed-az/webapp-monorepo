{
    "name": "ultramed-monorepo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "db:push": "pnpm --filter @ultramed/database exec prisma db push --schema=prisma/schema.prisma",
        "db:generate": "pnpm --filter @ultramed/database exec prisma generate --schema=prisma/schema.prisma",
        "db:seed": "node packages/database/prisma/seed.js",
        "db:setup": "pnpm db:push && pnpm db:generate && pnpm db:seed",
        "dev": "pnpm db:generate && pnpm -r dev",
        "build": "pnpm -r build",
        "lint": "echo 'ESLint is disabled for this project.'",
        "docker:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml up --build",
        "docker:build": "docker compose --env-file .env.production -f docker-compose.build.yml up -d --build",
        "docker-up:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml up --build -d",
        "docker-up:build": "docker compose --env-file .env.production -f docker-compose.build.yml up --build -d",
        "docker-down:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml down",
        "docker-down:build": "docker compose --env-file .env.production -f docker-compose.build.yml down",
        "docker-logs:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml logs -f",
        "docker-logs:build": "docker compose --env-file .env.production -f docker-compose.build.yml logs -f"
    }
}
