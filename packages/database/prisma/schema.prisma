generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  titleAz    String
  titleEn    String
  titleRu    String
  summaryAz  String   @db.Text
  summaryEn  String   @db.Text
  summaryRu  String   @db.Text
  contentAz  String   @db.Text
  contentEn  String   @db.Text
  contentRu  String   @db.Text
  highlightsAz Json?
  highlightsEn Json?
  highlightsRu Json?
  iconKey    String?
  image      String?
  sortOrder  Int      @default(0)
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Doctor {
  id          String   @id @default(uuid())
  name        String
  titleAz    String
  titleEn    String
  titleRu    String
  bioAz      String   @db.Text
  bioEn      String   @db.Text
  bioRu      String   @db.Text
  profileAz  String?  @db.Text
  profileEn  String?  @db.Text
  profileRu  String?  @db.Text
  image      String?
  specialty  String
  experience String?
  educationAz String?
  educationEn String?
  educationRu String?
  roomAz     String?
  roomEn     String?
  roomRu     String?
  scheduleAz Json?
  scheduleEn Json?
  scheduleRu Json?
  languagesAz Json?
  languagesEn Json?
  languagesRu Json?
  proceduresAz Json?
  proceduresEn Json?
  proceduresRu Json?
  phone      String?
  email      String?
  tagsAz     Json?
  tagsEn     Json?
  tagsRu     Json?
  sortOrder  Int      @default(0)
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  titleAz    String
  titleEn    String
  titleRu    String
  contentAz  String   @db.Text
  contentEn  String   @db.Text
  contentRu  String   @db.Text
  excerptAz  String?  @db.Text
  excerptEn  String?  @db.Text
  excerptRu  String?  @db.Text
  authorName String?
  categoryAz String?
  categoryEn String?
  categoryRu String?
  image      String?
  published  Boolean  @default(false)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  publishedAt DateTime?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  roleAz    String?
  roleEn    String?
  roleRu    String?
  commentAz String   @db.Text
  commentEn String   @db.Text
  commentRu String   @db.Text
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String   @id @default(uuid())
  questionAz String
  questionEn String
  questionRu String
  answerAz   String   @db.Text
  answerEn   String   @db.Text
  answerRu   String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(uuid())
  imageUrl    String
  captionAz   String?
  captionEn   String?
  captionRu   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactInfo {
  id           String   @id @default(cuid())
  slug         String   @unique @default("main")
  addressAz    String
  addressEn    String
  addressRu    String
  mapLatitude  Float
  mapLongitude Float
  mapEmbedUrl  String   @db.Text
  phones       Json
  emails       Json
  workingHours Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HomeStat {
  id        String   @id
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
