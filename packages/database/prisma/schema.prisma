generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  sessions  AdminSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model Media {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  provider     String   @default("local-cdn")
  storageKey   String   @unique
  cdnUrl       String
  services     Service[]
  doctors      Doctor[]
  blogPosts    BlogPost[]
  galleryItems Gallery[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  titleAz    String
  titleEn    String
  titleRu    String
  summaryAz  String   @db.Text
  summaryEn  String   @db.Text
  summaryRu  String   @db.Text
  contentAz  String   @db.Text
  contentEn  String   @db.Text
  contentRu  String   @db.Text
  highlightsAz Json?
  highlightsEn Json?
  highlightsRu Json?
  iconKey    String?
  image      String?
  mediaId    String?
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0)
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mediaId])
}

model Doctor {
  id          String   @id @default(uuid())
  name        String
  titleAz    String
  titleEn    String
  titleRu    String
  bioAz      String   @db.Text
  bioEn      String   @db.Text
  bioRu      String   @db.Text
  profileAz  String?  @db.Text
  profileEn  String?  @db.Text
  profileRu  String?  @db.Text
  image      String?
  mediaId    String?
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  specialty  String
  experience String?
  educationAz String?
  educationEn String?
  educationRu String?
  educationDetailsAz String? @db.Text
  educationDetailsEn String? @db.Text
  educationDetailsRu String? @db.Text
  experienceDetailsAz String? @db.Text
  experienceDetailsEn String? @db.Text
  experienceDetailsRu String? @db.Text
  certificationsAz String? @db.Text
  certificationsEn String? @db.Text
  certificationsRu String? @db.Text
  roomAz     String?
  roomEn     String?
  roomRu     String?
  scheduleAz Json?
  scheduleEn Json?
  scheduleRu Json?
  languagesAz Json?
  languagesEn Json?
  languagesRu Json?
  proceduresAz Json?
  proceduresEn Json?
  proceduresRu Json?
  phone      String?
  email      String?
  tagsAz     Json?
  tagsEn     Json?
  tagsRu     Json?
  sortOrder  Int      @default(0)
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mediaId])
}

model BlogPost {
  id          String   @id @default(uuid())
  titleAz    String
  titleEn    String
  titleRu    String
  contentAz  String   @db.Text
  contentEn  String   @db.Text
  contentRu  String   @db.Text
  excerptAz  String?  @db.Text
  excerptEn  String?  @db.Text
  excerptRu  String?  @db.Text
  authorName String?
  categoryAz String?
  categoryEn String?
  categoryRu String?
  image      String?
  mediaId    String?
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  published  Boolean  @default(false)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  publishedAt DateTime?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mediaId])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  roleAz    String?
  roleEn    String?
  roleRu    String?
  commentAz String   @db.Text
  commentEn String   @db.Text
  commentRu String   @db.Text
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String   @id @default(uuid())
  questionAz String
  questionEn String
  questionRu String
  answerAz   String   @db.Text
  answerEn   String   @db.Text
  answerRu   String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(uuid())
  imageUrl    String
  mediaId     String?
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  captionAz   String?
  captionEn   String?
  captionRu   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mediaId])
}

model ContactInfo {
  id           String   @id @default(cuid())
  slug         String   @unique @default("main")
  addressAz    String
  addressEn    String
  addressRu    String
  mapLatitude  Float
  mapLongitude Float
  mapEmbedUrl  String   @db.Text
  phones       Json
  emails       Json
  workingHours Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  subject   String
  message   String   @db.Text
  locale    String   @default("az")
  source    String   @default("contact")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model ContentPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleAz       String
  titleEn       String
  titleRu       String
  descriptionAz String   @db.Text
  descriptionEn String   @db.Text
  descriptionRu String   @db.Text
  sectionsAz    Json?
  sectionsEn    Json?
  sectionsRu    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  textAz      String   @db.Text
  textEn      String   @db.Text
  textRu      String   @db.Text
  href        String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CheckupPackage {
  id          String   @id @default(uuid())
  titleAz     String
  titleEn     String
  titleRu     String
  subtitleAz  String?
  subtitleEn  String?
  subtitleRu  String?
  price       String
  currency    String   @default("₼")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppointmentRequest {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  serviceId     String?
  serviceTitle  String
  preferredDate String
  preferredTime String
  message       String?  @db.Text
  locale        String   @default("az")
  source        String   @default("homepage")
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model HomeStat {
  id        String   @id
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
